# Copy to .env and fill in real values. Never commit .env.

APP_NAME=Portfolio API
ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call this API.
# Add the deployed frontend origin before going live.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inbox that receives contact-form submissions.
CONTACT_RECIPIENT=you@example.com

# SMTP delivery. While any of these are blank, POST /contact returns 503
# instead of reporting a message as sent.
#
# Gmail: use smtp.gmail.com on port 587 and set SMTP_PASSWORD to a Google App
# Password from https://myaccount.google.com/apppasswords (requires 2-Step
# Verification). A normal account password will be rejected. Spaces are
# stripped automatically if you paste the spaced form.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_SENDER=you@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=15
